          },
          "data": {
            "kind": "chapter",
            "name": "Chapter 1 — The Storm"
          }
        },
        {
          "id": "sc1",
          "type": "scene",
          "position": {
            "x": 360,
            "y": 200
          },
          "data": {
            "kind": "scene",
            "background": "Lighthouse, storm night",
            "description": "Waves hit the rocks. Someone is knocking at the lighthouse door."
          }
        },
        {
          "id": "d1",
          "type": "decision",
          "position": {
            "x": 720,
            "y": 160
          },
          "data": {
            "kind": "decision",
            "prompt": "A stranger knocks. What do you do?",
            "choices": [
              {
                "id": "let",
                "label": "Let her in",
                "effects": [
                  {
                    "id": "f1",
                    "varId": "trust",
                    "op": "add",
                    "value": 2
                  }
                ]
              },
              {
                "id": "talk",
                "label": "Talk through the door",
                "effects": [
                  {
                    "id": "f2",
                    "varId": "trust",
                    "op": "add",
                    "value": 1
                  }
                ]
              },
              {
                "id": "ignore",
                "label": "Ignore the knock",
                "effects": [
                  {
                    "id": "f3",
                    "varId": "trust",
                    "op": "sub",
                    "value": 1
                  }
                ]
              }
            ]
          }
        },
        {
          "id": "mira1",
          "type": "dialog",
          "position": {
            "x": 1080,
            "y": 200
          },
          "data": {
            "kind": "dialog",
            "character": "Mira",
            "text": "The storm will not end tonight. Neither will this conversation."
          }
        },
        {
          "id": "lamp",
          "type": "chance",
          "position": {
            "x": 1440,
            "y": 200
          },
          "data": {
            "kind": "chance",
            "title": "The lamp",
            "show": "reveal",
            "outcomes": [
              {
                "id": "fail",
                "label": "The lamp flickers out",
                "weight": 1
              },
              {
                "id": "hold",
                "label": "The lamp holds",
                "weight": 2
              }
            ]
          }
        },
        {
          "id": "mira2",
          "type": "dialog",
          "position": {
            "x": 1800,
            "y": -20
          },
          "data": {
            "kind": "dialog",
            "character": "Mira",
            "text": "I can fix it — if you trust me with the key."
          }
        },
        {
          "id": "d2",
          "type": "decision",
          "position": {
            "x": 2160,
            "y": 200
          },
          "data": {
            "kind": "decision",
            "prompt": "Mira asks for the key to the lamp room.",
            "choices": [
              {
                "id": "give",
                "label": "Give her the key",
                "effects": [
                  {
                    "id": "f4",
                    "varId": "has_key",
                    "op": "set",
                    "value": true
                  }
                ],
                "condition": {
                  "mode": "all",
                  "clauses": [
                    {
                      "id": "c1",
                      "varId": "trust",
                      "cmp": ">=",
                      "value": 2
                    }
                  ]
                },
                "whenLocked": "show-locked",
                "lockedText": "Mira doesn't trust you enough yet"
              },
              {
                "id": "keep",
                "label": "Keep the key"
              },
              {
                "id": "out",
                "label": "Throw her out into the storm",
                "effects": [
                  {
                    "id": "f5",
                    "varId": "trust",
                    "op": "sub",
                    "value": 5
                  }
                ],
                "condition": {
                  "mode": "all",
                  "clauses": [
                    {
                      "id": "c2",
                      "varId": "trust",
                      "cmp": "<=",
                      "value": 0
                    }
                  ]
                },
                "whenLocked": "hide"
              }
            ]
          }
        },
        {
          "id": "check",
          "type": "condition",
          "position": {
            "x": 2520,
            "y": 200
          },
          "data": {
            "kind": "condition",
            "title": "Which morning?",
            "branches": [
              {
                "id": "ally",
                "label": "Trusted ally",
                "condition": {
                  "mode": "all",
                  "clauses": [
                    {
                      "id": "c3",
                      "varId": "has_key",
                      "cmp": "==",
                      "value": true
                    },
                    {
                      "id": "c4",
                      "varId": "trust",
                      "cmp": ">=",
                      "value": 2
                    }
                  ]
                }
              },
              {
                "id": "cold",
                "label": "Cold night",
                "condition": {
                  "mode": "all",
                  "clauses": [
                    {
                      "id": "c5",
                      "varId": "trust",
                      "cmp": "<=",
                      "value": 0
                    }
                  ]
                }
              }
            ]
          }
        },
        {
          "id": "endGood",
          "type": "end",
          "position": {
            "x": 2880,
            "y": -300
          },
          "data": {
            "kind": "end",
            "title": "Two Keepers",
            "description": "By dawn the lamp burns brighter than ever, and the lighthouse has two keepers.",
            "character": "Mira",
            "text": "Same time tomorrow, keeper?"
          }
        },
        {
          "id": "endBad",
          "type": "end",
          "position": {
            "x": 2880,
            "y": 180
          },
          "data": {
            "kind": "end",
            "title": "Alone in the Dark",
            "description": "The lamp dies. Nobody knocks again.",
            "character": "",
            "text": ""
          }
        },
        {
          "id": "endMid",
          "type": "end",
          "position": {
            "x": 2880,
            "y": 660
          },
          "data": {
            "kind": "end",
            "title": "Morning, Somehow",
            "description": "The storm passes. At first light, Mira steps out into the grey morning.",
            "character": "Mira",
            "text": "Thank you for the shelter. I won’t forget it."
          }
        }
